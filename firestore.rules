rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Both roles use Firebase Auth. Role and branch access are stored in
    // admin membership and cashier-to-branch mapping documents.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isCashier() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/cashier_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/cashier_access/$(request.auth.uid)).data.role == 'cashier';
    }

    function cashierBranchId() {
      return get(/databases/$(database)/documents/cashier_access/$(request.auth.uid)).data.branchId;
    }

    function isValidInventoryWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'barcode', 'productName', 'buyingPrice', 'sellingPrice', 'currentStock'])
        && d.id is string
        && d.buyingPrice is number && d.buyingPrice >= 0
        && d.sellingPrice is number && d.sellingPrice >= 0
        && d.currentStock is number;
    }

    function isValidSaleWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'transactionId', 'items', 'totalAmount', 'createdAt'])
        && d.id is string
        && d.totalAmount is number && d.totalAmount >= 0;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // A branch account is provisioned in Firebase Auth and mapped to its
    // branch by an admin. Cashiers may inspect only their own mapping.
    match /cashier_access/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Branch documents contain password hashes. Public branch data is
    // served from public_branches instead.
    match /branches/{branchId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      // Admins can update branch records. A cashier may change only the
      // password field on their assigned branch record.
      allow update: if isAdmin()
        || (isCashier() && cashierBranchId() == branchId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password']));
    }

    // This is the credential-free projection used by the public landing
    // page. Only Firebase-authenticated administrators may change it.
    match /public_branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isAdmin() || isCashier();
      allow create, update: if (isAdmin() || isCashier())
        && request.resource.data.id == itemId
        && isValidInventoryWrite();
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId());
      allow create: if request.resource.data.id == saleId && isValidSaleWrite()
        && (isAdmin() || (isCashier() && request.resource.data.branchId == cashierBranchId()));
      // Cashiers need to flag a sale as refunded from the Refunds page,
      // so update is allowed with the same shape validation as create -
      // full audit trail lives in the separate /refunds collection.
      allow update: if request.resource.data.id == saleId && isValidSaleWrite()
        && (isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId() && request.resource.data.branchId == cashierBranchId()));
      allow delete: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId());
      allow create: if request.resource.data.id == refundId
        && (isAdmin() || (isCashier() && request.resource.data.branchId == cashierBranchId()));
      allow update: if isAdmin() || (isCashier()
        && resource.data.branchId == cashierBranchId()
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }

    match /stock_adjustments/{adjustmentId} {
      allow read: if isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId());
      allow create: if request.resource.data.id == adjustmentId
        && (isAdmin() || (isCashier() && request.resource.data.branchId == cashierBranchId()));
      allow update: if isAdmin() || (isCashier()
        && resource.data.branchId == cashierBranchId()
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }

    // Cashiers may create expenses for their assigned branch; admins can
    // review and manage all branch records.
    match /branch_expenses/{expenseId} {
      allow read: if isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId());
      allow create: if isCashier() && request.resource.data.branchId == cashierBranchId()
        && request.resource.data.keys().hasAll([
          'id', 'name', 'amount', 'createdAt', 'recordedBy', 'branchId'
        ])
        && request.resource.data.id == expenseId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.createdAt is string
        && request.resource.data.recordedBy is string
        && request.resource.data.branchId is string;
      // An acknowledged-but-interrupted write can be retried against an
      // existing document. Allow only an identical cashier retry so records
      // remain immutable after creation.
      allow update: if isAdmin() || (isCashier()
        && resource.data.branchId == cashierBranchId()
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }

    match /activity_log/{entryId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.id == entryId
        && (isAdmin() || (isCashier() && request.resource.data.branchId == cashierBranchId()));
      // Sync retries use the same document ID. Permit a duplicate no-op write
      // after a previous create reached Firestore, without allowing anyone
      // other than admins to modify or remove the audit record.
      allow update: if isAdmin() || (isCashier()
        && resource.data.branchId == cashierBranchId()
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }

    // A branch device records the time at which one of its operational
    // writes reached Firestore. The admin dashboard uses this for a clear
    // per-branch database-sync indicator.
    match /branch_sync/{branchId} {
      allow read: if isAdmin();
      allow create, update: if (isAdmin() || (isCashier() && cashierBranchId() == branchId))
        && request.resource.data.branchId == branchId
        && request.resource.data.lastSyncedAt is string;
      allow delete: if isAdmin();
    }

    // Cashiers can access only their own branch conversation. Admins can
    // access all branch conversations. Exact duplicate updates are permitted
    // only so a retried queued message remains idempotent.
    match /chat_messages/{messageId} {
      allow read: if isAdmin() || (isCashier() && resource.data.branchId == cashierBranchId());
      allow create: if request.resource.data.id == messageId
        && request.resource.data.branchId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && ((isAdmin() && request.resource.data.senderRole == 'admin')
          || (isCashier() && request.resource.data.senderRole == 'cashier'
            && request.resource.data.branchId == cashierBranchId()));
      allow update: if isAdmin() || (isCashier()
        && resource.data.branchId == cashierBranchId()
        && request.resource.data == resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
